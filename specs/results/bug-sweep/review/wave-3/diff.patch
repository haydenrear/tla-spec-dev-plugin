+    repo = make_repo(tmp_path / "repo")
+    bare, commit_a = make_unit_upstream(tmp_path, "alpha")
+    home = make_home(repo, units={"alpha": unit_record(bare, commit_a)})
+    store = home / "skills" / "alpha"
