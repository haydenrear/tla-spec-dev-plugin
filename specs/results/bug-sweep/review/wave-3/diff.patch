+def pin_shim(home: Path, real_cli: Path) -> Path:
+    """A `bin/cli/skill-manager` shaped like the one `home shims` writes."""
+    shim = home / "bin" / "cli" / "skill-manager"
+    shim.parent.mkdir(parents=True, exist_ok=True)
+    shim.write_text(
+        "#!/usr/bin/env bash\n"
