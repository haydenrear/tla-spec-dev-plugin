+    """Why a node is not green, from positive evidence in its envelope."""
+    if status == "passed":
+        return None
+    if status == "failed":
+        return "assertion"
+    if status == "not_run":
+        return "skipped"
+    text = reason or ""
+    if "timed out" in text:
+        return "timeout"
+    if isinstance(exit_code, int) and (exit_code > 128 or exit_code < -1):
+        return "signal"
+    return "crash"
+
