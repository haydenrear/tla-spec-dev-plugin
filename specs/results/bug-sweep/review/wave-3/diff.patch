+def write_pin(repo: Path, alias: str, source: str, revision: str) -> Path:
+    manifest = repo / "skill-project.toml"
+    manifest.write_text(
+        '[project]\nname = "demo"\n\n'
+        f'[skills.{alias}]\nsource = "{source}"\nrevision = "{revision}"\n'
+    )
+    return manifest
