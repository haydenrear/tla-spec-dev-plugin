+        "echo SHIM-WAS-EXECUTED-AGAINST-ITS-OWN-HOME >&2; exit 79\n"
+        f'cli="${{SKILL_MANAGER_CLI:-{real_cli}}}"\n'
+        'exec "$cli" "$@"\n'
+    )
+    shim.chmod(shim.stat().st_mode | stat.S_IEXEC)
+    return shim
