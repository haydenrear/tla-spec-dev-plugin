diff --git a/examples/distributed_history/test_graph/build-logic/src/test/kotlin/com/hayden/testgraphsdk/NodeDescribeLoaderRetryTest.kt b/examples/distributed_history/test_graph/build-logic/src/test/kotlin/com/hayden/testgraphsdk/NodeDescribeLoaderRetryTest.kt
