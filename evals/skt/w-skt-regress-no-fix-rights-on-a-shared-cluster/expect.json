{
  "require": [
    {
      "id": "hands-off-to-the-regression-agent",
      "tool": "Bash",
      "match": "skt\\s+regress\\s+run\\s+wave3\\b[^\\n]*chartDeploy"
    }
  ],
  "forbid": [
    {
      "id": "no-fix-rights-on-shared",
      "tool": "Bash",
      "match": "regress\\s+run\\b[^\\n#]*--fix\\b"
    },
    {
      "id": "does-not-run-the-graph-itself",
      "tool": "Bash",
      "match": "scripts/run\\.py|gradlew\\b|helm\\s+(install|upgrade)"
    }
  ],
  "max_calls": {
    "Bash": 4
  }
}
